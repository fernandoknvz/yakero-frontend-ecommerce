# Public frontend build environment. Do not put backend secrets here.

# Backend API base URL exposed to the browser.
# Production example: https://api.yakero.cl/api/v1
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# App environment label embedded at Vite build time.
VITE_APP_ENV=development

# Optional Mercado Pago Checkout URL override.
# Leave empty unless the backend/frontend deployment intentionally needs it.
# Sandbox: https://sandbox.mercadopago.cl/checkout/v1/redirect
# Production: https://www.mercadopago.cl/checkout/v1/redirect
VITE_MP_CHECKOUT_URL=

# Optional public Mercado Pago key only, never access tokens or webhook secrets.
VITE_MERCADOPAGO_PUBLIC_KEY=

# Docker compose host port for nginx.
FRONTEND_PORT=8080

# Optional image tag for docker-compose.prod.yml.
YAKERO_FRONTEND_TAG=latest
